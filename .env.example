# Copy to .env.local for local development. Never commit real values.

# Supabase (required for a real deployment). The anon key is public by design; NEVER put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo mode: browser-only data, demo accounts and the persona switcher. Leave unset or "false" in production.
VITE_DEMO_MODE=false

# Public site URL (no trailing slash). Used for canonical/Open Graph URLs and sitemap.xml generation.
VITE_SITE_URL=
